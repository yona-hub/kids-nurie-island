{
  "name": "kids-nurie-island",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-release.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "preview:demo": "vite preview --host 127.0.0.1 --port 4174 --outDir ../../dist-demo",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:rls": "vitest run tests/rls",
    "assets:build": "node tools/asset-pipeline/build.mjs",
    "assets:storybook": "node scripts/build-storybook-content.mjs && node scripts/build-storybook-scenes.mjs",
    "assets:vector": "node scripts/build-vector-content.mjs",
    "assets:review": "node tools/asset-pipeline/review-server.mjs",
    "assets:brand": "node scripts/build-brand.mjs",
    "licenses": "node scripts/build-licenses.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "idb": "8.0.3",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.0.9",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.1",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.2",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
