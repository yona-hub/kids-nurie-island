{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@island/shared": ["./packages/shared-types/src/index.ts"],
      "@island/content": ["./packages/content-schema/src/index.ts"],
      "@island/engine": ["./packages/coloring-engine/src/index.ts"],
      "@island/persistence": ["./packages/persistence/src/index.ts"]
    }
  },
  "include": [
    "apps/web/src",
    "packages",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "supabase/functions"]
}
