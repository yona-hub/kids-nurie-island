# Public browser configuration. Copy to .env.local and use your own Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Explicit local demonstration only. Keep false for normal production.
# npm run dev also permits a local account when BOTH Supabase values are absent.
VITE_DEMO_MODE=false

# Public support mailbox shown in Settings > 問い合わせ. Use an address you operate.
VITE_CONTACT_EMAIL=

# Edge Function secret, set with `supabase secrets set`, never with VITE_ prefix:
# APP_ORIGINS=https://your-app.example
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.
